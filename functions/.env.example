# Firebase Web API key used by login, password reset, and token refresh.
WEB_API_KEY=

# Optional when Firebase Functions supplies application-default credentials.
APP_FIREBASE_PROJECT_ID=
APP_STORAGE_BUCKET=FIREBASE_PROJECT_ID.firebasestorage.app
APP_FIREBASE_CLIENT_EMAIL=
APP_FIREBASE_PRIVATE_KEY=

# Paystack server-side configuration.
PAYSTACK_SECRET_KEY=
PAYSTACK_CURRENCY=ZAR

# Comma-separated production origins, without trailing slashes.
# Example: https://www.booksbotsdrones.com,https://admin.booksbotsdrones.com
CORS_ORIGINS=
